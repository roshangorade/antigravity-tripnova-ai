# ==========================================================
# TripNova.ai — Application Environment Configuration
# ==========================================================

# GEMINI_API_KEY: Required for Gemini AI Trip Planner and Intelligence queries
GEMINI_API_KEY="your_gemini_api_key_here"

# DATABASE_URL: PostgreSQL connection URI (Local Postgres or Supabase/Neon/RDS)
# Example: postgresql://postgres:postgres@localhost:5432/tripnova
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tripnova"

# Optional Granular PostgreSQL Parameters (used if DATABASE_URL is not set)
# SQL_HOST="localhost"
# SQL_PORT=5432
# SQL_USER="postgres"
# SQL_PASSWORD="your_password"
# SQL_DATABASE="tripnova"

# JWT_SECRET: Strong secret for signing and verifying user session JWTs
JWT_SECRET="tripnova_secure_jwt_secret_key_2026_production"

# ADMIN_SECRET_KEY: Passkey required for registering as an Administrator
ADMIN_SECRET_KEY="TRIPNOVA_ADMIN_2026"

# SERPAPI_API_KEY: Live hotel availability and property details via Google Hotels
SERPAPI_API_KEY=""

# WEATHER_API_KEY: Optional API key for live weather forecasts via WeatherAPI
WEATHER_API_KEY=""

# Razorpay Test Credentials (for test payment simulation & signature verification)
RAZORPAY_KEY_ID="rzp_test_sampleKey12345"
RAZORPAY_KEY_SECRET="sampleSecretKey67890"

# Application Hosting Configuration
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
